# Copie variáveis para o ambiente do servidor (não versione segredos).
STUDIO_HOST=127.0.0.1
STUDIO_PORT=8765
# OBRIGATÓRIO para qualquer acesso em rede, além de HTTPS no reverse proxy.
STUDIO_TOKEN=
STUDIO_WORKSPACE=
STUDIO_DB=
# Para planejar tarefas via Responses API (pode gerar custos).
OPENAI_API_KEY=
OPENAI_MODEL=
# Só habilite em runner isolado, com Codex CLI e Git instalado e autenticado.
ENABLE_CODEX_EXEC=0
